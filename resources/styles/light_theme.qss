/* ================================================================
   KBS Monitoring v2 — 라이트 테마 QSS
   주간 모드용. 어두운 배경 대신 밝은 배경, accent는 동일 orange.
   ================================================================ */

QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
    font-family: "Pretendard", "Malgun Gothic", "Segoe UI", sans-serif;
    font-size: 12px;
}

QMainWindow {
    background-color: #eeeeee;
}

QWidget#topBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dddddd;
}

QFrame#topBarSeparator {
    color: #cccccc;
    background-color: #cccccc;
    max-width: 1px;
}

QPushButton {
    background-color: #e8e8e8;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #dddddd;
    border-color: #D97757;
}

QPushButton:pressed {
    background-color: #D97757;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #D97757;
    color: #ffffff;
    border-color: #B85E3F;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #aaaaaa;
    border-color: #dddddd;
}

QPushButton#btnDetection:checked {
    background-color: #D97757;
    color: #ffffff;
}

QPushButton#btnSignoff[signoff_state="IDLE"] {
    background-color: #e8e8e8;
    color: #555555;
}

QPushButton#btnSignoff[signoff_state="PREPARATION"] {
    background-color: #fff3cd;
    color: #856404;
    border-color: #ffc107;
}

QPushButton#btnSignoff[signoff_state="SIGNOFF"] {
    background-color: #f8d7da;
    color: #842029;
    border-color: #e03131;
}


/* 섹션 소제목 */
QLabel#lblSectionTitle {
    font-size: 10px;
    font-weight: 600;
    color: #888888;
    letter-spacing: 1px;
    background: transparent;
}

/* 볼륨 수치 레이블 */
QLabel#lblVolumeVal {
    font-size: 10px;
    color: #666666;
    background: transparent;
}


QSlider::groove:horizontal {
    background-color: #dddddd;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #D97757;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}

QSlider::sub-page:horizontal {
    background-color: #D97757;
    border-radius: 2px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
}

QSpinBox {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 2px 4px;
}

QWidget#videoArea {
    background-color: #222222;
}

QLabel#videoLabel {
    background-color: #111111;
}

QWidget#logArea {
    background-color: #ffffff;
}

QWidget#logHeaderArea {
    background-color: #f8f8f8;
    border-bottom: 1px solid #dddddd;
}

QLabel#logHeader {
    color: #D97757;
    font-weight: bold;
    font-size: 12px;
    letter-spacing: 1px;
}

QListWidget#logList {
    background-color: #ffffff;
    border: none;
    outline: none;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QListWidget#logList::item {
    padding: 0px;
    border: none;
}

QListWidget#logList::item:hover {
    background-color: rgba(0, 0, 0, 0.03);
}

/* 타입 필터 행 */
QWidget#logFilterArea {
    background-color: #f5f5f5;
    border-bottom: 1px solid #dddddd;
}

/* 검색 행 */
QWidget#logSearchArea {
    background-color: #f5f5f5;
    border-bottom: 1px solid #dddddd;
}

QLineEdit#logSearchInput {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 2px 6px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QLineEdit#logSearchInput:focus {
    border-color: #D97757;
}

/* count badge */
QLabel#logCountBadge {
    color: #888888;
    background-color: #eeeeee;
    border: 1px solid #cccccc;
    border-radius: 8px;
    padding: 1px 5px;
    font-size: 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

/* 타입 필터 버튼 */
QPushButton#btnLogFilter {
    background-color: transparent;
    color: #aaaaaa;
    border: 1px solid #cccccc;
    border-radius: 10px;
    padding: 1px 8px;
    font-size: 10px;
    font-weight: bold;
    min-width: 36px;
}

QPushButton#btnLogFilter:hover {
    border-color: #D97757;
    color: #D97757;
    background-color: rgba(217, 119, 87, 0.06);
}

/* 자동 스크롤 재개 버튼 */
QPushButton#btnScrollResume {
    background-color: rgba(217, 119, 87, 0.10);
    color: #D97757;
    border: 1px solid rgba(217, 119, 87, 0.5);
    border-radius: 10px;
    padding: 1px 10px;
    font-size: 10px;
    font-weight: bold;
}

QPushButton#btnScrollResume:hover {
    background-color: #D97757;
    color: #ffffff;
}

/* 검색 / DEBUG / 헤더 버튼 */
QPushButton#btnLogClear,
QPushButton#btnLogFolder,
QPushButton#btnLogDebug,
QPushButton#btnLogSearch,
QPushButton#btnLogSearchClose {
    background-color: transparent;
    color: #888888;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
}

QPushButton#btnLogClear:hover,
QPushButton#btnLogFolder:hover,
QPushButton#btnLogDebug:hover,
QPushButton#btnLogSearch:hover,
QPushButton#btnLogSearchClose:hover {
    border-color: #D97757;
    color: #D97757;
    background-color: rgba(217, 119, 87, 0.08);
}

QPushButton#btnLogDebug:checked,
QPushButton#btnLogSearch:checked {
    background-color: rgba(217, 119, 87, 0.12);
    color: #D97757;
    border-color: #D97757;
}

QSplitter#mainSplitter::handle {
    background-color: #dddddd;
    width: 4px;
}

QSplitter#mainSplitter::handle:hover {
    background-color: #D97757;
}

QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #D97757;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #dddddd;
}

QTabBar::tab {
    background-color: #f0f0f0;
    color: #666666;
    border: 1px solid #dddddd;
    padding: 6px 14px;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #D97757;
}

QComboBox {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 3px 8px;
}

QComboBox:hover {
    border-color: #D97757;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    selection-background-color: #D97757;
    selection-color: #ffffff;
}

QCheckBox {
    spacing: 6px;
    color: #1a1a1a;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #cccccc;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    border-color: #D97757;
    image: url(__CHECK_ICON_URL__);
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #D97757;
}

QGroupBox {
    border: 1px solid #dddddd;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 4px;
}

QGroupBox::title {
    color: #D97757;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QLabel#lblTime {
    color: #B85E3F;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 18px;
    letter-spacing: 2px;
}

/* ── 감지현황 배지 ──────────────────────────────────────────────── */
QFrame#detBadge {
    background-color: #efefef;
    border: 1px solid #cccccc;
    border-radius: 3px;
    min-width: 32px;
}

QLabel#detBadgeKey {
    color: #888888;
    font-size: 9px;
    background-color: transparent;
}

QLabel#detBadgeVal {
    color: #1a1a1a;
    font-weight: bold;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    background-color: transparent;
}

QFrame#detBadge[alert="true"] {
    background-color: #fde8e8;
    border-color: #e03131;
}

QFrame#detBadge[alert="true"] QLabel#detBadgeVal {
    color: #cc0000;
}

QFrame#detBadge[ea_state="alert"] {
    background-color: #fde8e8;
    border-color: #e03131;
}

QFrame#detBadge[ea_state="alert"] QLabel#detBadgeVal {
    color: #cc0000;
}

QFrame#detBadge[ea_state="disabled"] QLabel#detBadgeVal {
    color: #aaaaaa;
}

/* 알림확인 버튼 alarm_active */
QPushButton#btnAlarmAck[alarm_active="true"] {
    background-color: #cc0000;
    color: #ffffff;
    border-color: #aa0000;
}

/* 감지 버튼 health state */
QPushButton#btnDetection[health_state="stale"] {
    border: 2px solid #cc0000;
    color: #cc0000;
}

QPushButton#btnDetection[health_state="crashed"] {
    border: 2px solid #D97757;
    color: #D97757;
}

/* ================================================================
   설정 다이얼로그 — 라이트 테마
   ================================================================ */

/* ── 탭 바 ──────────────────────────────────────────────────────── */
QWidget#settingsTabBar {
    background-color: #f0f0f0;
    border-bottom: 1px solid #cccccc;
}

QPushButton#settingsTabBtn {
    background-color: #e8e8e8;
    color: #555555;
    border: 1px solid #cccccc;
    border-bottom: 2px solid #cccccc;
    border-radius: 4px 4px 0 0;
    padding: 6px 12px;
    font-size: 11px;
}

QPushButton#settingsTabBtn:hover {
    color: #D97757;
    background-color: #f0f0f0;
    border-color: #D97757;
    border-bottom: 2px solid #D97757;
}

QPushButton#settingsTabBtn:checked {
    color: #D97757;
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-bottom: 2px solid #D97757;
}

/* ── 섹션 박스 ──────────────────────────────────────────────────── */
QFrame#settingsSection {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

QFrame#settingsSection QWidget {
    background-color: transparent;
}

QFrame#settingsSection QLineEdit,
QFrame#settingsSection QComboBox,
QFrame#settingsSection QSpinBox {
    background-color: #f8f8f8;
    color: #1a1a1a;
    min-height: 24px;
    max-height: 26px;
    padding: 2px 8px;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

QFrame#settingsSection QLineEdit:focus,
QFrame#settingsSection QComboBox:focus {
    border-color: #D97757;
}

QFrame#settingsSection QPushButton {
    min-height: 24px;
    max-height: 28px;
    padding: 3px 12px;
    border-radius: 4px;
}

QFrame#settingsSection QCheckBox {
    color: #1a1a1a;
    font-size: 12px;
    spacing: 6px;
}

QFrame#settingsSection QCheckBox::indicator {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 3px;
    width: 14px;
    height: 14px;
}

QFrame#settingsSection QCheckBox::indicator:checked {
    border-color: #D97757;
    image: url(__CHECK_ICON_URL__);
}

/* ── 섹션 타이틀 / 행 라벨 / 설명 ─────────────────────────────── */
QLabel#settingsSectionLabel {
    color: #D97757;
    font-weight: bold;
    font-size: 13px;
    padding: 0px;
    margin: 0px;
}

QLabel#settingsRowLabel {
    color: #1a1a1a;
    font-size: 12px;
}

QLabel#settingsDesc {
    color: #888888;
    font-size: 11px;
}

QFrame#settingsSep {
    color: #dddddd;
    background-color: #dddddd;
    max-height: 1px;
    border: none;
    margin: 4px 0;
}

/* ── 공통 액션 버튼 ─────────────────────────────────────────────── */
QPushButton#btnPrimary {
    background-color: #D97757;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#btnPrimary:hover {
    background-color: #E8906A;
}

QPushButton#btnPrimary:pressed {
    background-color: #B85E3F;
}

QPushButton#btnDanger {
    background-color: transparent;
    color: #cc3333;
    border: 1px solid #cc3333;
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#btnDanger:hover {
    background-color: #cc3333;
    color: #ffffff;
}

QPushButton#btnDanger:pressed {
    background-color: #992222;
    border-color: #992222;
    color: #ffffff;
}

/* ── ROI 테이블 ─────────────────────────────────────────────────── */
QTableWidget#roiTable {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #D97757;
    border-radius: 3px;
    gridline-color: #dddddd;
}

QTableWidget#roiTable QHeaderView::section {
    background-color: #fff0ea;
    color: #D97757;
    font-weight: bold;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid #D97757;
    border-right: 1px solid #dddddd;
    padding: 3px 4px;
}

QTableWidget#roiTable::item {
    border-bottom: 1px solid #f0f0f0;
    padding: 2px 4px;
}

QTableWidget#roiTable::item:selected {
    background-color: #fde8db;
    color: #B85E3F;
}

/* ── 저장/불러오기 탭 카드 ─────────────────────────────────────── */
QFrame#saveActionCard {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

QFrame#saveActionCard:hover {
    border-color: #D97757;
}

QLabel#saveCardIcon {
    font-size: 22px;
    color: #D97757;
    background-color: transparent;
}

QLabel#saveCardTitle {
    font-size: 13px;
    font-weight: bold;
    color: #1a1a1a;
    background-color: transparent;
}

QLabel#saveCardDesc {
    font-size: 11px;
    color: #888888;
    background-color: transparent;
}

QPushButton#btnOutlineOrange {
    background-color: transparent;
    color: #D97757;
    border: 1px solid #D97757;
    border-radius: 5px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: bold;
    min-width: 90px;
}

QPushButton#btnOutlineOrange:hover {
    background-color: #D97757;
    color: #ffffff;
}

QPushButton#btnOutlineOrange:pressed {
    background-color: #B85E3F;
    border-color: #B85E3F;
    color: #ffffff;
}

QPushButton#btnOutlineDanger {
    background-color: transparent;
    color: #cc3333;
    border: 1px solid #cc3333;
    border-radius: 5px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: bold;
    min-width: 90px;
}

QPushButton#btnOutlineDanger:hover {
    background-color: #cc3333;
    color: #ffffff;
}

QPushButton#btnOutlineDanger:pressed {
    background-color: #992222;
    border-color: #992222;
    color: #ffffff;
}

/* ── About 카드 ─────────────────────────────────────────────────── */
QFrame#aboutCard {
    background-color: #fafafa;
    border: 1px solid #dddddd;
    border-radius: 8px;
}

QLabel#aboutCardVersion {
    font-size: 18px;
    font-weight: bold;
    color: #D97757;
    background-color: transparent;
}

QLabel#aboutCardMeta {
    font-size: 11px;
    color: #888888;
    background-color: transparent;
}


/* ── ROI 단축키 안내 ────────────────────────────────────────────── */
QFrame#roiShortcutCard {
    background-color: #f5f5f5;
    border: 1px solid #dddddd;
    border-radius: 6px;
    padding: 0px;
}

QLabel#roiShortcutLabel {
    font-size: 11px;
    color: #444444;
    background-color: transparent;
    border: none;
    padding: 0px;
}

/* ── 영상설정 탭: 용량 추정 프레임 ──────────────────────────────── */
QFrame#capacityFrame {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 4px;
}

QFrame#capacityFrame QWidget {
    background-color: transparent;
}

QLabel#capacityHeader {
    color: #666666;
    font-size: 11px;
    background: transparent;
}

QLabel#capacityBar {
    background: transparent;
    color: #1a1a1a;
}

/* ── 섹션 하위 헤더 (▸ 비디오 / ▸ 오디오 등) ────────────────────── */
QLabel#sectionSubHeader {
    color: #666666;
    font-size: 11px;
    margin-top: 4px;
}

/* ── 저장 결과 상태 라벨 ────────────────────────────────────────── */
QLabel#saveStatusLabel {
    font-size: 11px;
    padding-left: 46px;
    background: transparent;
}

QLabel#saveStatusLabel[status="ok"] {
    color: #1a1a1a;
}

QLabel#saveStatusLabel[status="error"] {
    color: #cc3333;
}
